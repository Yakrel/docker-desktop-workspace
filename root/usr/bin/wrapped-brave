#!/bin/bash

BIN=/usr/bin/brave-browser
CONFIG_DIR="$HOME/.config/BraveSoftware/Brave-Browser"

# Ensure config dir exists
mkdir -p "$CONFIG_DIR"

# Aggressive cleanup of lock files
rm -f "$CONFIG_DIR/SingletonLock" "$CONFIG_DIR/SingletonCookie" "$CONFIG_DIR/SingletonSocket" 2>/dev/null

${BIN} \
  --no-first-run \
  --no-sandbox \
  --test-type \
  --password-store=basic \
  --simulate-outdated-no-au='Tue, 31 Dec 2099 23:59:59 GMT' \
  --start-maximized \
  --user-data-dir="$CONFIG_DIR" \
  --disable-dev-shm-usage \
  --enable-gpu-rasterization \
  --enable-zero-copy \
  --ignore-gpu-blocklist \
  "$@"
