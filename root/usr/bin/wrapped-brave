#!/bin/bash

BIN=/usr/bin/brave-origin
CONFIG_DIR="$HOME/.config/BraveSoftware/Brave-Origin"

# Ensure config dir exists
mkdir -p "$CONFIG_DIR"

# Safely clean up stale locks if not running
if [ -L "$CONFIG_DIR/SingletonLock" ]; then
  LOCK_VAL=$(readlink "$CONFIG_DIR/SingletonLock")
  LOCK_PID=${LOCK_VAL##*-}
  LOCK_HOST=${LOCK_VAL%-*}

  if [ "$LOCK_HOST" = "$(hostname)" ] && [ -d "/proc/$LOCK_PID" ]; then
    # Brave is running, do not touch the locks
    true
  else
    # Lock is stale, clean it up
    rm -f "$CONFIG_DIR/SingletonLock" "$CONFIG_DIR/SingletonCookie" "$CONFIG_DIR/SingletonSocket" 2>/dev/null
  fi
fi

# Use native Wayland rendering when the Selkies Wayland compositor is active.
if [[ -e /dev/dri/renderD128 ]] && pgrep labwc > /dev/null 2>&1; then
  WAYLAND="--ozone-platform=wayland"
fi

# Enable Chromium accessibility support for the optional Pelorus interface.
if [[ "${PELORUS,,}" == "true" ]]; then
  ACCESSIBILITY="--force-renderer-accessibility"
fi

${BIN} \
  --no-first-run \
  --no-sandbox \
  --test-type \
  --password-store=basic \
  --simulate-outdated-no-au='Tue, 31 Dec 2099 23:59:59 GMT' \
  --start-maximized \
  --user-data-dir="$CONFIG_DIR" \
  --disable-dev-shm-usage \
  --enable-gpu-rasterization \
  --enable-zero-copy \
  --ignore-gpu-blocklist \
  ${WAYLAND} \
  ${ACCESSIBILITY} \
  "$@"
