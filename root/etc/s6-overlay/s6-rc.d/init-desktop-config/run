#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Keep the Labwc desktop launchers aligned with this image.
mkdir -p /config/.config/labwc
cp /defaults/menu_wayland.xml /config/.config/labwc/menu.xml
cp /defaults/autostart_wayland /config/.config/labwc/autostart

# Preserve the existing KEYBOARD setting through Wayland's XKB interface.
if [[ -n "${KEYBOARD:-}" ]]; then
    printf '%s' "$KEYBOARD" > /run/s6/container_environment/XKB_DEFAULT_LAYOUT
fi

# permissions
lsiown -R abc:abc \
    /config
lsiown -R abc:abc \
    /opt/obsidian
